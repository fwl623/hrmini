# Nginx 反向代理示例（联调/演示服务器部署）
# 服务器 IP 示例：39.101.67.167
# 用法：复制到 /etc/nginx/conf.d/hrms.conf 后 nginx -s reload

upstream hrms_backend {
    server 127.0.0.1:8080;
}

server {
    listen 80;
    server_name 39.101.67.167;

    # 后端 API
    location /api/ {
        proxy_pass http://hrms_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # 前端静态资源（npm run build 后 dist/ 部署到此目录）
    location / {
        root /opt/hrmini/frontend/dist;
        try_files $uri $uri/ /index.html;
    }
}
