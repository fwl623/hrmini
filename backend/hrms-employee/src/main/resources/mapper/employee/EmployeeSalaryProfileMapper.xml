<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.company.hrms.module.employee.repository.EmployeeSalaryProfileMapper">

    <select id="selectByEmployeeId" resultType="com.company.hrms.module.employee.entity.EmployeeSalaryProfileEntity">
        SELECT * FROM employee_salary_profile
        WHERE employee_id = #{employeeId}
        LIMIT 1
    </select>

</mapper>
