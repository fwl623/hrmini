<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.company.hrms.module.employee.repository.EmployeeMapper">

    <!-- 通用查询映射 -->
    <resultMap id="BaseResultMap" type="com.company.hrms.module.employee.entity.EmployeeEntity">
        <id column="id" property="id"/>
        <result column="employee_no" property="employeeNo"/>
        <result column="user_id" property="userId"/>
        <result column="name" property="name"/>
        <result column="gender" property="gender"/>
        <result column="mobile" property="mobile"/>
        <result column="email" property="email"/>
        <result column="department_id" property="departmentId"/>
        <result column="position_id" property="positionId"/>
        <result column="grade" property="grade"/>
        <result column="manager_id" property="managerId"/>
        <result column="work_location" property="workLocation"/>
        <result column="hire_date" property="hireDate"/>
        <result column="employment_type" property="employmentType"/>
        <result column="employment_status" property="employmentStatus" typeHandler="org.apache.ibatis.type.ByteTypeHandler"/>
        <result column="last_work_day" property="lastWorkDay"/>
        <result column="probation_pay_ratio" property="probationPayRatio"/>
        <result column="deleted" property="deleted"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
        <result column="version" property="version"/>
    </resultMap>

    <!-- 列表搜索结果映射 -->
    <resultMap id="ListVOMap" type="com.company.hrms.module.employee.vo.EmployeeListVO">
        <result column="id" property="employeeId"/>
        <result column="employee_no" property="empNo"/>
        <result column="name" property="name"/>
        <result column="department_name" property="department"/>
        <result column="position_name" property="position"/>
        <result column="grade" property="grade"/>
        <result column="employment_status" property="employmentStatus"/>
        <result column="hire_date" property="hireDate"/>
    </resultMap>

    <!-- 高级搜索：员工列表分页 -->
    <select id="search" resultMap="ListVOMap">
        SELECT e.id, e.employee_no, e.name, e.grade, e.employment_status, e.hire_date,
               d.name AS department_name,
               p.name AS position_name
        FROM employee e
        LEFT JOIN department d ON e.department_id = d.id AND d.deleted = 0
        LEFT JOIN position p ON e.position_id = p.id AND p.deleted = 0
        WHERE e.deleted = 0
        <if test="keyword != null and keyword != ''">
            AND (e.name LIKE CONCAT('%', #{keyword}, '%')
            OR e.employee_no LIKE CONCAT('%', #{keyword}, '%')
            OR e.mobile LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        <if test="deptIds != null and deptIds.size > 0">
            AND e.department_id IN
            <foreach collection="deptIds" item="deptId" open="(" separator="," close=")">
                #{deptId}
            </foreach>
        </if>
        <if test="positionIds != null and positionIds.size > 0">
            AND e.position_id IN
            <foreach collection="positionIds" item="posId" open="(" separator="," close=")">
                #{posId}
            </foreach>
        </if>
        <if test="statusList != null and statusList.size > 0">
            AND e.employment_status IN
            <foreach collection="statusList" item="status" open="(" separator="," close=")">
                #{status}
            </foreach>
        </if>
        <if test="gradeList != null and gradeList.size > 0">
            AND e.grade IN
            <foreach collection="gradeList" item="grade" open="(" separator="," close=")">
                #{grade}
            </foreach>
        </if>
        <if test="hireDateFrom != null">
            AND e.hire_date &gt;= #{hireDateFrom}
        </if>
        <if test="hireDateTo != null">
            AND e.hire_date &lt;= #{hireDateTo}
        </if>
        ${dataScope}
        ORDER BY e.id DESC
    </select>

    <!-- 高级搜索计数 -->
    <select id="countSearch" resultType="long">
        SELECT COUNT(1)
        FROM employee e
        LEFT JOIN department d ON e.department_id = d.id AND d.deleted = 0
        LEFT JOIN position p ON e.position_id = p.id AND p.deleted = 0
        WHERE e.deleted = 0
        <if test="keyword != null and keyword != ''">
            AND (e.name LIKE CONCAT('%', #{keyword}, '%')
            OR e.employee_no LIKE CONCAT('%', #{keyword}, '%')
            OR e.mobile LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        <if test="deptIds != null and deptIds.size > 0">
            AND e.department_id IN
            <foreach collection="deptIds" item="deptId" open="(" separator="," close=")">
                #{deptId}
            </foreach>
        </if>
        <if test="positionIds != null and positionIds.size > 0">
            AND e.position_id IN
            <foreach collection="positionIds" item="posId" open="(" separator="," close=")">
                #{posId}
            </foreach>
        </if>
        <if test="statusList != null and statusList.size > 0">
            AND e.employment_status IN
            <foreach collection="statusList" item="status" open="(" separator="," close=")">
                #{status}
            </foreach>
        </if>
        <if test="gradeList != null and gradeList.size > 0">
            AND e.grade IN
            <foreach collection="gradeList" item="grade" open="(" separator="," close=")">
                #{grade}
            </foreach>
        </if>
        <if test="hireDateFrom != null">
            AND e.hire_date &gt;= #{hireDateFrom}
        </if>
        <if test="hireDateTo != null">
            AND e.hire_date &lt;= #{hireDateTo}
        </if>
        ${dataScope}
    </select>

    <!-- 根据员工ID查询 -->
    <select id="selectByEmployeeId" resultMap="BaseResultMap">
        SELECT * FROM employee WHERE id = #{employeeId} AND deleted = 0
    </select>

    <!-- 根据工号查询 -->
    <select id="selectByEmployeeNo" resultMap="BaseResultMap">
        SELECT * FROM employee WHERE employee_no = #{employeeNo} AND deleted = 0
    </select>

    <!-- 根据手机号查询 -->
    <select id="selectByMobile" resultMap="BaseResultMap">
        SELECT * FROM employee WHERE mobile = #{mobile} AND deleted = 0
    </select>

</mapper>
