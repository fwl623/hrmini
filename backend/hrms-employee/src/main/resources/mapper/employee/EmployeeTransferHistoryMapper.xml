<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.company.hrms.module.employee.repository.EmployeeTransferHistoryMapper">

    <resultMap id="TransferHistoryVOMap" type="com.company.hrms.module.employee.vo.EmployeeTransferHistoryVO">
        <result column="id" property="id"/>
        <result column="employee_id" property="employeeId"/>
        <result column="from_dept" property="fromDepartment"/>
        <result column="to_dept" property="toDepartment"/>
        <result column="from_pos" property="fromPosition"/>
        <result column="to_pos" property="toPosition"/>
        <result column="transfer_date" property="transferDate"/>
        <result column="reason" property="reason"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="selectByEmployeeId" resultMap="TransferHistoryVOMap">
        SELECT th.id,
               th.employee_id,
               fd.name AS from_dept,
               td.name AS to_dept,
               fp.name AS from_pos,
               tp.name AS to_pos,
               th.transfer_date,
               th.reason,
               th.created_at
        FROM employee_transfer_history th
        LEFT JOIN department fd ON th.from_department_id = fd.id
        LEFT JOIN department td ON th.to_department_id = td.id
        LEFT JOIN position fp ON th.from_position_id = fp.id
        LEFT JOIN position tp ON th.to_position_id = tp.id
        WHERE th.employee_id = #{employeeId}
        ORDER BY th.transfer_date DESC
    </select>

</mapper>
