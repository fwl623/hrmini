<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.company.hrms.payroll.mapper.PayrollSchemeScopeMapper">

    <resultMap id="BaseResultMap" type="com.company.hrms.payroll.entity.PayrollSchemeScope">
        <id column="id" property="id" />
        <result column="scheme_id" property="schemeId" />
        <result column="scope_type" property="scopeType" />
        <result column="scope_id" property="scopeId" />
    </resultMap>

    <select id="selectBySchemeId" resultMap="BaseResultMap">
        SELECT * FROM payroll_scheme_scope WHERE scheme_id = #{schemeId}
    </select>

    <delete id="deleteBySchemeId">
        DELETE FROM payroll_scheme_scope WHERE scheme_id = #{schemeId}
    </delete>

</mapper>
